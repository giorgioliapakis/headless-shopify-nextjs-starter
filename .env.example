# Copy this file to .env.local. As shipped it boots a working storefront with
# ZERO Shopify credentials, using the built-in demo fixture. Replace the three
# fixture values with the "real store" block below when you connect Shopify.
#
# Shortcut: `pnpm dev:demo` sets these itself and needs no .env file at all.

# Credential-free demo storefront: a full catalogue, collections, blog, menus,
# pages, policies and a working cart. The fixture never turns on by itself and
# refuses to run against a real merchant domain, a real token, or a private token.
SHOPIFY_STOREFRONT_FIXTURE="demo"
PUBLIC_STORE_DOMAIN="demo-fixture.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN="demo-public-token"
SHOPIFY_API_VERSION="2026-07"

# Frozen single-product fixture used by the build, browser and bundle gates.
# Deterministic by design, and deliberately too sparse to evaluate the UI.
# SHOPIFY_STOREFRONT_FIXTURE="neutral"
# PUBLIC_STORE_DOMAIN="neutral-fixture.myshopify.com"
# PUBLIC_STOREFRONT_API_TOKEN="fixture-public-token"

# Required — your own Shopify Storefront API credentials.
# Delete SHOPIFY_STOREFRONT_FIXTURE above, then uncomment and fill these in.
# PUBLIC_STORE_DOMAIN="your-store.myshopify.com"
# PUBLIC_STOREFRONT_API_TOKEN="your-public-storefront-access-token"

# Optional — Shopify Headless channel values.
# A real private token is required for trusted buyer-context clients; never put a public token here.
# PRIVATE_STOREFRONT_API_TOKEN="your-private-storefront-access-token"
# PUBLIC_STOREFRONT_ID="gid://shopify/Storefront/123456789"
# PUBLIC_CHECKOUT_DOMAIN="checkout.your-domain.com"

# Deprecated aliases accepted temporarily during migration:
# SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
# SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-public-storefront-access-token"

# Store display name (shown in header, metadata, etc.)
NEXT_PUBLIC_SITE_NAME="Your Store Name"

# Optional — hosted Shopify customer account destination.
# NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL="https://account.example.com"

# Optional — Base URL for absolute links (sitemap, OG tags, auth callbacks).
# Defaults to https://${VERCEL_PROJECT_PRODUCTION_URL} when on Vercel.
# NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Optional — consent-aware Shopify storefront analytics and hosted privacy banner.
# Disabled unless explicitly set to true.
# NEXT_PUBLIC_SHOPIFY_ANALYTICS_ENABLED="true"

# Optional — Shopify webhook signature verification.
# Required if you wire up /api/webhooks/shopify.
# SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"

# Optional — CMS draft mode (preview unpublished metaobject content).
# Required if you use /api/draft for CMS preview links.
# CMS_DRAFT_MODE_SECRET="your-draft-mode-secret"

# Optional — Verbose Shopify Storefront API request logging in the server console.
# DEBUG_SHOPIFY="true"
