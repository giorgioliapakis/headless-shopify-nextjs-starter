{
  "_comment": "LCP budgets are calibrated against GitHub Actions runners, which simulate ~700ms slower than local hardware (Lantern scales with observed CPU speed). Measured medians: home/PDP ~3093ms on CI vs ~2409ms locally; collections ~2858ms and search ~2709ms locally. The LCP element on every fixture page is server-rendered text (observed paint ~140ms); the simulated value is dominated by the initial JS transfer graph, so budgets carry ~10% headroom over measured CI values instead of chasing simulation noise. LHCI only reads the 'ci' key; this comment is ignored.",
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/verify/browser-server.mjs",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:3100/",
        "http://127.0.0.1:3100/collections/neutral-collection",
        "http://127.0.0.1:3100/products/neutral-product",
        "http://127.0.0.1:3100/search",
        "http://127.0.0.1:3100/cart"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-gpu",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:3100/(?:$|products/|cart$)",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": [
              "error",
              { "maxNumericValue": 3400, "aggregationMethod": "median" }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:3100/(?:collections/|search$)",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.93 }],
            "largest-contentful-paint": [
              "error",
              { "maxNumericValue": 3800, "aggregationMethod": "median" }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:3100/(?:$|collections/|products/)",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:seo": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".artifacts/lighthouse" }
  }
}
