{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.local/schemas/approval-envelope-v1.json",
  "title": "Externally signed privileged approval envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "actor",
    "runId",
    "shop",
    "environment",
    "action",
    "issuedAt",
    "expiresAt",
    "bindings",
    "scope",
    "riskRationale"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decisionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authentication"],
      "properties": {
        "id": { "type": "string" },
        "authentication": { "type": "string" }
      }
    },
    "runId": { "type": "string" },
    "shop": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,61}\\.myshopify\\.com$" },
    "environment": { "enum": ["preview", "production"] },
    "action": {
      "enum": [
        "preview",
        "deploy",
        "shopify-change",
        "webhook-change",
        "tracking-change",
        "domain-attachment",
        "dns-change",
        "cutover",
        "rollback",
        "observation"
      ]
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSnapshotSha256",
        "previewDeploymentSha256",
        "evidenceSha256",
        "checksSha256",
        "proposalSha256"
      ],
      "properties": {
        "sourceSnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "previewDeploymentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "checksSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "proposalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._/-]{0,119}$" }
    },
    "riskRationale": { "type": "string", "minLength": 10, "maxLength": 1000 }
  }
}
