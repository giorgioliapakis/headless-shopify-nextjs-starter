{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify.dev/schemas/migration/decision-v1.json",
  "title": "Migration review decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "summary",
    "recordedAt",
    "sourceSnapshotId",
    "authority",
    "isProductionApproval"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "status": { "enum": ["pending", "accepted", "rejected"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "sourceSnapshotId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "const": "migration-review-only" },
    "isProductionApproval": { "const": false }
  }
}
