{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.invalid/schemas/foundation-drift-v1.json",
  "title": "Foundation drift v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "detectedAt",
    "status",
    "changedPaths",
    "invalidates",
    "previousSha256",
    "currentSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "detectedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["changed", "not-recorded"] },
    "changedPaths": { "type": "array", "items": { "type": "string" } },
    "missing": { "type": "array", "items": { "type": "string" } },
    "invalidates": {
      "type": "array",
      "items": { "enum": ["reconstruction", "verification", "review"] }
    },
    "previousSha256": {
      "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
    },
    "currentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
