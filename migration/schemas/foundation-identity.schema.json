{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.invalid/schemas/foundation-identity-v1.json",
  "title": "Foundation contract identity v1",
  "type": "object",
  "required": ["schemaVersion", "status", "sha256", "fileCount", "bytes", "files", "missing"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["current", "incomplete"] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileCount": { "type": "integer", "minimum": 0, "maximum": 2000 },
    "bytes": { "type": "integer", "minimum": 0, "maximum": 26214400 },
    "files": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "missing": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
