{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.invalid/schemas/integration-inventory-v1.json",
  "title": "Integration inventory v1",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "evidenceTrust", "items", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "evidenceTrust": { "const": "theme-structure-reference-only" },
    "items": { "type": "array", "maxItems": 500 },
    "summary": { "type": "object" }
  },
  "additionalProperties": false
}
