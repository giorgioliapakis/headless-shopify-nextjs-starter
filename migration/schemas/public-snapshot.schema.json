{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify.dev/schemas/migration/public-snapshot-v1.json",
  "title": "Credential-free public storefront snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "capturedAt",
    "source",
    "limits",
    "robots",
    "sitemap",
    "discovery",
    "pages",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["origin", "mode", "evidenceTrust"],
      "properties": {
        "origin": { "type": "string", "format": "uri" },
        "mode": { "const": "credential-free-public" },
        "evidenceTrust": { "const": "untrusted" }
      }
    },
    "limits": { "type": "object" },
    "robots": { "type": "object" },
    "sitemap": { "type": "object" },
    "discovery": {
      "type": "object",
      "required": ["maxDepth", "routes", "sitemapOnlyCount", "linkedNotSitemapCount"]
    },
    "pages": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["url", "path", "type", "status"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "path": { "type": "string", "pattern": "^/" },
          "type": {
            "enum": [
              "home",
              "collection-index",
              "product",
              "collection",
              "blog",
              "article",
              "page",
              "landing",
              "policy",
              "search",
              "cart",
              "account",
              "checkout",
              "other"
            ]
          },
          "status": { "type": "integer", "minimum": 0, "maximum": 599 },
          "accessState": { "enum": ["public", "password-gated"] },
          "canonical": { "type": ["string", "null"], "maxLength": 500 },
          "robots": { "type": ["string", "null"], "maxLength": 300 },
          "hreflang": { "type": "array", "maxItems": 50 },
          "structuredDataTypes": { "type": "array", "maxItems": 100 },
          "discovery": { "type": "object" },
          "evidencePath": { "type": ["string", "null"], "pattern": "^(evidence/public/pages/|$)" }
        }
      }
    },
    "summary": { "type": "object" }
  }
}
