{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify.dev/schemas/migration/reconstruction-plan-v1.json",
  "title": "Bounded reconstruction suggestion model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "evidenceTrust",
    "rules",
    "routes",
    "theme",
    "integrations",
    "brand",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["publicSnapshotId", "themeManifestSha256"],
      "properties": {
        "publicSnapshotId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "themeManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "evidenceTrust": { "const": "untrusted-source-derived-bounded-model" },
    "rules": { "type": "object" },
    "routes": { "type": "array", "maxItems": 500 },
    "theme": { "type": "object" },
    "integrations": { "type": "object" },
    "brand": {
      "type": "object",
      "required": [
        "status",
        "rules",
        "colors",
        "fontCandidates",
        "logoReferences",
        "layoutCandidates"
      ],
      "properties": {
        "status": { "enum": ["observed-unmapped", "not-observed"] },
        "rules": { "type": "object" },
        "colors": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
        "fontCandidates": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
        "logoReferences": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
        "layoutCandidates": { "type": "array", "maxItems": 200 }
      }
    },
    "summary": { "type": "object" }
  }
}
