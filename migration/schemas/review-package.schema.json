{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.local/schemas/review-package-v1.json",
  "title": "Local migration review package",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "scope",
    "productionExposure",
    "launchAuthority",
    "summary",
    "stateSignals",
    "blockers",
    "requiredReviews",
    "routes",
    "sections",
    "provenance",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "scope": { "const": "local-only-migration-review" },
    "productionExposure": { "const": false },
    "launchAuthority": { "const": "none-review-is-not-production-approval" },
    "summary": {
      "type": "object",
      "required": ["readinessStatus", "launchReady", "blockerCount", "staleArtifactCount"],
      "properties": {
        "readinessStatus": { "type": "string" },
        "launchReady": { "const": false },
        "blockerCount": { "type": "integer", "minimum": 0 },
        "staleArtifactCount": { "type": "integer", "minimum": 0 }
      }
    },
    "stateSignals": { "type": "object" },
    "blockers": { "type": "array" },
    "requiredReviews": { "type": "array" },
    "recordedDecisions": { "type": "array" },
    "routes": { "type": "array" },
    "sections": { "type": "array" },
    "provenance": {
      "type": "object",
      "required": ["artifacts", "rawEvidenceIncluded", "sourceCodeIncluded"],
      "properties": {
        "artifacts": { "type": "array" },
        "rawEvidenceIncluded": { "const": false },
        "sourceCodeIncluded": { "const": false },
        "editorialCopyIncluded": { "const": false }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "string" } }
  }
}
