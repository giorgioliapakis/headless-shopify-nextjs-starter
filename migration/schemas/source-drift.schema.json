{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify.dev/schemas/migration/source-drift-v1.json",
  "title": "Public storefront source drift",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "previousSnapshotId",
    "currentSnapshotId",
    "added",
    "removed",
    "changed",
    "affectedPaths",
    "invalidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["baseline", "unchanged", "changed"] },
    "previousSnapshotId": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "currentSnapshotId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "added": { "type": "array" },
    "removed": { "type": "array" },
    "changed": { "type": "array" },
    "affectedPaths": { "type": "array", "items": { "type": "string" } },
    "invalidates": { "type": "array", "items": { "type": "string" } }
  }
}
