{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.local/schemas/target-coverage-v1.json",
  "title": "Foundation reconstruction target coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "policy", "routes", "summary", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["publicSnapshotId", "themeManifestSha256"],
      "properties": {
        "publicSnapshotId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "themeManifestSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "policy": { "type": "object" },
    "routes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["sourcePath", "sourceType", "target", "strategy", "status", "sha256"],
        "properties": {
          "sourcePath": { "type": "string" },
          "sourceType": { "type": "string" },
          "target": { "type": "string" },
          "strategy": { "type": "string" },
          "status": {
            "enum": ["available", "hosted-handoff", "downstream-required", "missing", "invalid"]
          },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "routeCount",
        "available",
        "hostedHandoffs",
        "downstreamRequired",
        "missing",
        "invalid",
        "blockedCount"
      ]
    },
    "status": { "enum": ["current", "blocked"] }
  }
}
