{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.invalid/schemas/template-clusters-v1.json",
  "title": "Template clusters v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "evidenceTrust",
    "routeClusters",
    "themeClusters",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "evidenceTrust": { "const": "untrusted-source-derived-bounded-model" },
    "routeClusters": { "type": "array", "maxItems": 500 },
    "themeClusters": { "type": "array", "maxItems": 500 },
    "summary": { "type": "object" }
  },
  "additionalProperties": false
}
