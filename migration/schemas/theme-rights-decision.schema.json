{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.invalid/schemas/theme-rights-decision-v1.json",
  "title": "Theme rights decision v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "itemId",
    "category",
    "status",
    "basis",
    "summary",
    "recordedAt",
    "themeSourceIdentity",
    "themeManifestSha256",
    "authority",
    "foundationRedistribution"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "itemId": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "status": { "enum": ["approved-downstream", "excluded"] },
    "basis": {
      "enum": [
        "merchant-owned",
        "license-reviewed",
        "app-terms-reviewed",
        "excluded-from-migration"
      ]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "themeSourceIdentity": { "type": "string", "minLength": 40 },
    "themeManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authority": { "const": "downstream-asset-use-review-only" },
    "foundationRedistribution": { "const": false }
  },
  "additionalProperties": false
}
