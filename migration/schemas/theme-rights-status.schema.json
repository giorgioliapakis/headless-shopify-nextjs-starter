{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.invalid/schemas/theme-rights-status-v1.json",
  "title": "Theme rights status v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "themeSourceIdentity",
    "themeManifestSha256",
    "authority",
    "foundationRedistribution",
    "items",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "themeSourceIdentity": { "type": "string", "minLength": 40 },
    "themeManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authority": { "const": "downstream-asset-use-review-only" },
    "foundationRedistribution": { "const": false },
    "items": { "type": "array" },
    "summary": {
      "type": "object",
      "required": ["itemCount", "unresolved", "approvedDownstream", "excluded", "complete"],
      "properties": {
        "itemCount": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 },
        "approvedDownstream": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
