{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shopify-starter.invalid/schemas/unknown-inventory-v1.json",
  "title": "Unknown reconstruction inventory v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "launchPolicy",
    "routes",
    "sections",
    "integrations",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "launchPolicy": {
      "const": "every-revenue-critical-unknown-must-be-resolved-or-explicitly-excluded"
    },
    "routes": { "type": "array", "maxItems": 500 },
    "sections": { "type": "array", "maxItems": 5000 },
    "integrations": { "type": "array", "maxItems": 500 },
    "summary": { "type": "object" }
  },
  "additionalProperties": false
}
