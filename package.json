{
  "name": "headless-shopify-nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Production-shaped headless Shopify storefront on Next.js 16 with a credential-free demo mode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giorgioliapakis/headless-shopify-nextjs-starter.git"
  },
  "homepage": "https://headless-shopify-nextjs.vercel.app",
  "bugs": {
    "url": "https://github.com/giorgioliapakis/headless-shopify-nextjs-starter/issues"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "node scripts/demo/dev.mjs",
    "build": "next build",
    "start": "next start",
    "check": "pnpm typegen && pnpm lint && tsc --noEmit && pnpm check:graphql && pnpm budget:query && vitest run && pnpm supply-chain:audit && node scripts/agents/verify-skills.mjs && node scripts/security/repo-scan.mjs",
    "check:graphql": "node scripts/verify/graphql.mjs",
    "lint": "oxlint . && oxfmt --check",
    "format": "oxfmt",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "typegen": "next typegen",
    "storefront:doctor": "node --env-file-if-exists=.env.local scripts/shopify/doctor.mjs",
    "browser:install": "playwright install chromium",
    "browser:test": "pnpm verify:production && playwright test",
    "browser:test:built": "playwright test",
    "lighthouse": "pnpm verify:production && node scripts/verify/lighthouse.mjs",
    "lighthouse:built": "node scripts/verify/lighthouse.mjs",
    "verify:production": "node scripts/verify/production.mjs",
    "budget:bundle": "node scripts/performance/bundle-budget.mjs",
    "budget:query": "node scripts/performance/query-budget.mjs",
    "supply-chain:audit": "node scripts/security/audit-lifecycle-scripts.mjs && node scripts/security/audit-licenses.mjs",
    "scan": "node scripts/security/repo-scan.mjs",
    "skills:sync": "node scripts/agents/sync-hydrogen-skills.mjs && node scripts/agents/sync-claude-skills.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@shopify/hydrogen": "0.0.0-preview-8a708a8-20260708155454",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "next-intl": "4.13.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "postcss": "8.5.16",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "gql.tada": "1.11.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.5.0"
  },
  "packageManager": "pnpm@11.5.0"
}
