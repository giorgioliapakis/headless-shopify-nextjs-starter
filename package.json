{
  "name": "template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "graphql-codegen && next build",
    "check": "pnpm typegen && oxlint . && oxfmt --check && tsc --noEmit && vitest run && node scripts/upstream/verify.mjs && node scripts/agents/verify-skills.mjs && node scripts/clean-room/scan.mjs",
    "clean-room": "node scripts/clean-room/scan.mjs",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "dev": "graphql-codegen || true && next dev",
    "dev:portless": "graphql-codegen || true && portless shop next dev",
    "format": "oxfmt",
    "lint": "oxlint . && oxfmt --check",
    "verify:upstream": "node scripts/upstream/verify.mjs",
    "start": "next start",
    "test": "vitest run",
    "typegen": "graphql-codegen && next typegen"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@graphql-codegen/cli": "7.1.3",
    "@shopify/api-codegen-preset": "2.0.1",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "next-intl": "4.13.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "postcss": "8.5.16",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.5.0"
  },
  "packageManager": "pnpm@11.5.0"
}
