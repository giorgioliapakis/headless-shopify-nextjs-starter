{
  "name": "template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "agents:qualify": "node scripts/agents/qualification.mjs",
    "agents:qualify:alpha": "node scripts/agents/qualification.mjs --mode alpha",
    "browser:install": "playwright install chromium",
    "browser:test": "pnpm verify:production && playwright test",
    "browser:test:built": "playwright test",
    "budget:bundle": "node scripts/performance/bundle-budget.mjs",
    "budget:query": "node scripts/performance/query-budget.mjs",
    "check": "pnpm typegen && oxlint . && oxfmt --check && tsc --noEmit && pnpm check:graphql && pnpm budget:query && pnpm agents:qualify && vitest run && pnpm supply-chain:audit && node scripts/upstream/verify.mjs && node scripts/agents/verify-skills.mjs && node scripts/clean-room/scan.mjs",
    "check:graphql": "node scripts/verify/graphql.mjs",
    "clean-room": "node scripts/clean-room/scan.mjs",
    "dev": "next dev",
    "dev:portless": "portless shop next dev",
    "format": "oxfmt",
    "foundation:update": "node scripts/foundation/update.mjs",
    "lint": "oxlint . && oxfmt --check",
    "lighthouse": "pnpm verify:production && node scripts/verify/lighthouse.mjs",
    "lighthouse:built": "node scripts/verify/lighthouse.mjs",
    "migrate": "node migration/cli.mjs",
    "quarantine:verify": "node scripts/security/quarantine.mjs",
    "release:verify": "pnpm check && pnpm verify:production && node scripts/release/verify.mjs",
    "skills:sync:hydrogen": "node scripts/agents/sync-hydrogen-skills.mjs && node scripts/agents/sync-claude-skills.mjs",
    "verify:upstream": "node scripts/upstream/verify.mjs",
    "verify:production": "node scripts/verify/production.mjs",
    "start": "next start",
    "storefront:doctor": "node --env-file-if-exists=.env.local scripts/shopify/doctor.mjs",
    "supply-chain:audit": "node scripts/security/audit-lifecycle-scripts.mjs && node scripts/security/audit-licenses.mjs",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@shopify/hydrogen": "0.0.0-preview-8a708a8-20260708155454",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "next-intl": "4.13.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "postcss": "8.5.16",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "gql.tada": "1.11.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.5.0"
  },
  "packageManager": "pnpm@11.5.0"
}
